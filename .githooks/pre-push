#!/usr/bin/env bash
# Gate de push (ative com: git config core.hooksPath .githooks)
#   1. CI local (espelho do workflow) — o gate verde NÃO depende do GitHub Actions.
#   2. Curadoria de publicação: varre a árvore pushada com a denylist PRIVADA do
#      mantenedor (~/.config/curadoria-publica/denylist.txt) — fail-closed.
# Contribuidor externo sem denylist: SKIP_CURADORIA=1 git push ... (o CI público
# genérico continua cobrindo o PR).
set -u

repo_root="$(git rev-parse --show-toplevel)"

echo "▶ pre-push: CI local"
bash "$repo_root/scripts/ci-local.sh" || exit 1

if [ "${SKIP_CURADORIA:-0}" = "1" ]; then
  echo "▶ pre-push: curadoria PULADA (SKIP_CURADORIA=1)"
  exit 0
fi
deny="$HOME/.config/curadoria-publica/denylist.txt"
if [ ! -r "$deny" ]; then
  echo "✗ curadoria: denylist ausente em $deny — push BLOQUEADO (fail-closed)." >&2
  echo "  Contribuidor externo: use SKIP_CURADORIA=1 git push ..." >&2
  exit 1
fi
pat="$(grep -v '^\s*#' "$deny" | grep -v '^\s*$' | paste -sd'|' -)"
fail=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  hits="$(git grep -iE -n "$pat" "$local_sha" -- 2>/dev/null)"
  if [ -n "$hits" ]; then
    echo "✗ curadoria: termos sensíveis na árvore $local_sha — push BLOQUEADO:" >&2
    echo "$hits" | head -20 >&2
    fail=1
  fi
done
[ "$fail" -eq 0 ] && echo "▶ pre-push: curadoria OK"
exit $fail
